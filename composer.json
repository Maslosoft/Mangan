            "homepage": "http://www.invenzzia.org",
            "role": "Developer"
        },
        {
            "name": "Philippe Gaultier",
            "email": "pgaultier@ibitux.com",
            "role": "Developer"
        },
        {
            "name": "Ibitux",
            "homepage": "http://www.ibitux.com",
            "role": "Developer"
        },
        {
            "name": "CleverIT",
            "homepage": "http://www.cleverit.com.pl",
            "role": "Developrt"
        },
        {
            "name": "Florian Fackler",
            "email": "florian.fackler@mintao.com",
            "homepage": "http://mintao.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Maslosoft/Mangan/issues",
        "docs": "https://maslosoft.com/mangan/docs/"
    },
    "require": {
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mongodb": "^2.1",
        "imagine/imagine": "^1.5",
        "maslosoft/addendum": "^7.0.6",
        "maslosoft/cli-shared": "^2.0.5",
        "maslosoft/embedi": "^3.0",
        "maslosoft/gazebo": "^2.0.2",
        "maslosoft/light": "^2.0",
        "maslosoft/signals": "^4.0.7",
        "mongodb/mongodb": "^2.1",
        "php": ">=8.5",
        "psr/log": "^3.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.3",
        "ext-curl": "*",
        "maslosoft/miniview": "^2.0.4",
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "monolog/monolog": "Sends your logs to files, sockets, inboxes, databases and various web services",
        "ptachoire/php-dmtx": "Generate DataMatrix Codes",
        "endroid/qrcode": "Generate QR Codes",
        "khanamiryan/qrcode-detector-decoder": "Decode QR Codes"
    },
    "autoload": {
        "psr-4": {
            "Maslosoft\\Mangan\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php",
            "src/Helpers/Cursor/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Maslosoft\\ManganTest\\Models\\": "tests/models/",
            "Maslosoft\\ManganTest\\Extensions\\": "tests/extensions/"
        }
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "test:build": "@php -d register_argc_argv=1 vendor/bin/codecept build",
        "test:compatibility": "@php -d error_reporting=-1 tests/compatibility.php",
        "test": [
            "@test:build @no_additional_args",
            "@php -d register_argc_argv=1 -d error_reporting=-1 vendor/bin/codecept run unit"
        ],
        "check": [
            "@lint",
            "@test:compatibility",
            "@test:runtime",
            "@test"
        ],
        "test:runtime": "@php -d error_reporting=-1 tests/runtime.php"
    },
    "config": {
        "sort-packages": true
    }
}
